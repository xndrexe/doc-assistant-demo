# Модель — любой сервис с API в формате OpenAI. Меняются три строки ниже.
# Примеры адресов:
#   OpenRouter (есть бесплатные модели): https://openrouter.ai/api/v1
#   OpenAI:                              https://api.openai.com/v1
#   Groq:                                https://api.groq.com/openai/v1
#   Ollama на своём сервере:             http://localhost:11434/v1   (ключ не нужен)
LLM_BASE_URL=
LLM_API_KEY=
# Имя модели у выбранного сервиса — единственное, что меняют, чтобы поставить другую модель
LLM_MODEL=
# Сколько токенов модель может потратить на ответ; «думающим» моделям нужно больше
LLM_MAX_TOKENS=1500

# Папка с документами (PDF, DOCX, TXT, MD); относительный путь — от папки проекта.
# По умолчанию — выдуманные документы из samples/. Сюда же бот кладёт загруженные администратором файлы
DOCS_DIR=samples

# Telegram: токен от @BotFather и id администраторов через запятую (им можно загружать и удалять документы)
TELEGRAM_TOKEN=
ADMIN_IDS=
